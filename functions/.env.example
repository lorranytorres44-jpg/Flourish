# Copie este arquivo para functions/.env e preencha UM dos provedores.
# O Firebase CLI lê functions/.env no deploy; o arquivo .env não vai para o git.

# Provedor de rastreio: "cws" (API oficial dos Correios) ou "linketrack".
# Se omitido, usa cws quando CORREIOS_USUARIO existir, senão linketrack.
CORREIOS_PROVIDER=linketrack

# --- Link & Track (gratuito; crie a conta em https://linketrack.com) ---
LINKETRACK_USER=
LINKETRACK_TOKEN=

# --- API oficial dos Correios (exige contrato; credenciais no Meu Correios > CWS) ---
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
