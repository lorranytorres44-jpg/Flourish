rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function souEu(uid) { return request.auth != null && request.auth.uid == uid; }

    // Perfis: leitura pública (nome/foto/cidade de quem anuncia). Só o próprio
    // usuário cria, edita e apaga (ao excluir a conta).
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if souEu(userId);

      // WhatsApp, no formato (11) 99999-9999: o botão "Trocar" da página do
      // livro abre a conversa com o anunciante. Só quem está logado lê.
      match /contato/{docId} {
        allow read: if request.auth != null;
        allow create, update: if souEu(userId) && docId == 'whatsapp' &&
          request.resource.data.keys().hasOnly(['telefone']) &&
          request.resource.data.telefone.matches('^\\([0-9]{2}\\) [0-9]{4,5}-[0-9]{4}$');
        allow delete: if souEu(userId);
      }

      match /favorites/{bookId} {
        allow read, write: if souEu(userId);
      }
    }

    // Avaliações de perfil: leitura pública. Quem está logado avalia outro
    // usuário (nunca a si mesmo) com nota de 1 a 5 e comentário opcional; o id
    // "avaliado_autor" garante uma avaliação por pessoa, que não é editada
    // (o autor só a apaga, ao excluir a conta). O dono do perfil avaliado
    // responde uma vez: só ele grava "resposta" e "respostaEm", e só se ainda
    // não houver resposta.
    match /ratings/{ratingId} {
      function r() { return request.resource.data; }
      allow read: if true;
      allow create: if request.auth != null &&
        r().autorId == request.auth.uid &&
        r().avaliadoId != request.auth.uid &&
        ratingId == r().avaliadoId + '_' + request.auth.uid &&
        r().keys().hasOnly(['avaliadoId', 'autorId', 'nota', 'comentario', 'criadoEm']) &&
        r().nota is int && r().nota >= 1 && r().nota <= 5 &&
        r().comentario is string && r().comentario.size() <= 500 &&
        exists(/databases/$(database)/documents/users/$(r().avaliadoId));
      allow update: if request.auth != null &&
        resource.data.avaliadoId == request.auth.uid &&
        !('resposta' in resource.data) &&
        mudou().hasOnly(['resposta', 'respostaEm']) &&
        r().resposta is string && r().resposta.size() > 0 && r().resposta.size() <= 500 &&
        r().respostaEm is string;
      allow delete: if request.auth != null && resource.data.autorId == request.auth.uid;
    }

    // Livros anunciados: leitura pública (é a biblioteca), só o dono cria,
    // edita e apaga. Outros usuários só mexem nas curtidas.
    match /books/{bookId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.ownerId == request.auth.uid && !mudou().hasAny(['ownerId'])) ||
        mudou().hasOnly(['curtidas'])
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
